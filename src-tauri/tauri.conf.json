{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brisk",
  "version": "1.1.0",
  "identifier": "com.brisk.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Brisk",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset: http://asset.localhost https://cdnjs.cloudflare.com",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost https://cdnjs.cloudflare.com",
        "font-src": "'self' customprotocol: asset: http://asset.localhost https://fastly.jsdelivr.net/ https://cdn.jsdelivr.net/ https://cdnjs.cloudflare.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://cdnjs.cloudflare.com",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com http://asset.localhost https://cdn.jsdelivr.net/ https://cdnjs.cloudflare.com/",
        "script-src": "'unsafe-inline' 'self' https://fonts.googleapis.com http://asset.localhost https://cdnjs.cloudflare.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
